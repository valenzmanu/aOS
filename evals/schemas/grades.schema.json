{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/valenzmanu/aOS/evals/schemas/grades.schema.json",
  "title": "aOS evaluation grades",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id",
    "run_status",
    "grading_method",
    "governance",
    "mission",
    "rubric_version",
    "judge_version",
    "reasoning_artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "run_status": {
      "enum": [
        "valid",
        "infrastructure_invalid"
      ]
    },
    "grading_method": {
      "enum": [
        "deterministic_fixture",
        "rubric_judge"
      ]
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score",
        "checks"
      ],
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "passed",
              "details"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "passed": {
                "type": "boolean"
              },
              "details": {
                "type": "string"
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "event_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "mission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score",
        "dimensions"
      ],
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "dimensions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "score",
              "details"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "score": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "details": {
                "type": "string"
              },
              "reasoning_artifact": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "rubric_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "judge_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "reasoning_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
